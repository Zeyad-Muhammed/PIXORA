<Page
    x:Class="PIXORA.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PIXORA.App.Views"
    Background="{ThemeResource PxBg0}" IsTabStop="True">

    <Page.Resources>
        <Style x:Key="ToolRow" TargetType="ToggleButton" BasedOn="{StaticResource PxToolToggle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.ColumnSpan="2" Background="{ThemeResource PxBg0}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,0,0,1" Padding="18,0,14,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource PxAccent}" />
                <TextBlock x:Name="DocTitle" Text="Editor" Style="{StaticResource PxHeadlineSm}" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center" />
                <Ellipse x:Name="DirtyDot" Width="8" Height="8" Fill="{StaticResource PxAccent}" VerticalAlignment="Center" Visibility="Collapsed" ToolTipService.ToolTip="Unsaved changes" />
                <TextBlock x:Name="DocInfo" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="{ThemeResource PxBg1}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="10" Padding="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="UndoButton" Style="{StaticResource PxGhostButton}" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><FontIcon Glyph="&#xE7A7;" FontSize="14" /></Button>
                    <Button x:Name="RedoButton" Style="{StaticResource PxGhostButton}" Click="Redo_Click" ToolTipService.ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><FontIcon Glyph="&#xE7A6;" FontSize="14" /></Button>
                    <Border Width="1" Background="{ThemeResource PxBorder}" Margin="4,6" />
                    <Button Style="{StaticResource PxGhostButton}" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+-)" AutomationProperties.Name="Zoom out"><FontIcon Glyph="&#xE71F;" FontSize="14" /></Button>
                    <Button x:Name="ZoomText" Style="{StaticResource PxGhostButton}" Content="100%" MinWidth="60" Click="Zoom100_Click" ToolTipService.ToolTip="Actual pixels (Ctrl+1)" />
                    <Button Style="{StaticResource PxGhostButton}" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in"><FontIcon Glyph="&#xE8A3;" FontSize="14" /></Button>
                    <Button Style="{StaticResource PxGhostButton}" Click="Fit_Click" ToolTipService.ToolTip="Fit to window (Ctrl+0)" AutomationProperties.Name="Fit to window"><FontIcon Glyph="&#xE9A6;" FontSize="14" /></Button>
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource PxGhostButton}" Click="Open_Click" ToolTipService.ToolTip="Open image (Ctrl+O)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="14" /><TextBlock Text="Open" /></StackPanel>
                </Button>
                <Button x:Name="CopyButton" Style="{StaticResource PxSecondaryButton}" Click="Copy_Click" ToolTipService.ToolTip="Copy edited image (Ctrl+C)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="14" /><TextBlock Text="Copy image" /></StackPanel>
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource PxSecondaryButton}" Click="SaveAs_Click" ToolTipService.ToolTip="Save as PNG, JPEG or WebP (Ctrl+Shift+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Export" /></StackPanel>
                </Button>
                <Button x:Name="SaveButton" Style="{StaticResource PxPrimaryButton}" Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74E;" FontSize="14" /><TextBlock Text="Save" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Canvas -->
        <Grid x:Name="CanvasArea" Grid.Row="1" Background="{ThemeResource PxBg0}" AllowDrop="True" DragOver="Canvas_DragOver" Drop="Canvas_Drop">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Disabled"
                          PointerWheelChanged="Scroller_PointerWheelChanged" SizeChanged="Scroller_SizeChanged">
                <Grid x:Name="CanvasPad" Padding="40,40,40,110">
                    <views:CursorGrid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                          PointerPressed="Canvas_PointerPressed" PointerMoved="Canvas_PointerMoved" PointerReleased="Canvas_PointerReleased"
                          PointerCanceled="Canvas_PointerReleased" DoubleTapped="Canvas_DoubleTapped">
                        <Border BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" Margin="-1" />
                        <Image x:Name="CanvasImage" Stretch="Fill" />
                    </views:CursorGrid>
                </Grid>
            </ScrollViewer>

            <Border x:Name="SizeBadge" Background="#E61A1A1D" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Visibility="Collapsed">
                <TextBlock x:Name="SizeBadgeText" FontSize="12" Foreground="#E5EEF0" FontFamily="{StaticResource PxMono}" />
            </Border>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420">
                <Border Style="{StaticResource PxIconTile}" Width="64" Height="64"><FontIcon Glyph="&#xE70F;" FontSize="26" /></Border>
                <TextBlock Text="Nothing open yet" Style="{StaticResource PxHeadlineMd}" HorizontalAlignment="Center" />
                <TextBlock Text="Take a screenshot, open an image, paste one from the clipboard, or drop a file here." Style="{StaticResource PxBodySecondary}" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PxPrimaryButton}" Click="NewCapture_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7A8;" FontSize="14" /><TextBlock Text="Capture region" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PxSecondaryButton}" Click="Open_Click" Content="Open image" />
                    <Button Style="{StaticResource PxSecondaryButton}" Click="Paste_Click" Content="Paste" />
                </StackPanel>
            </StackPanel>

            <!-- Floating tool dock -->
            <Border x:Name="ToolDock" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Background="{ThemeResource PxElevated}"
                    BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="12" Padding="6">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <ToggleButton x:Name="DockSelect" Tag="Select" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Select / move (V)" AutomationProperties.Name="Select"><FontIcon Glyph="&#xE7C9;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockRect" Tag="Rectangle" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Rectangle (R)" AutomationProperties.Name="Rectangle"><FontIcon Glyph="&#xE739;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockEllipse" Tag="Ellipse" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Ellipse (E)" AutomationProperties.Name="Ellipse"><FontIcon Glyph="&#xEA3A;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockArrow" Tag="Arrow" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Arrow (A)" AutomationProperties.Name="Arrow"><FontIcon Glyph="&#xE72A;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockText" Tag="Text" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Text (T)" AutomationProperties.Name="Text"><FontIcon Glyph="&#xE8D2;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockBlur" Tag="Blur" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Blur (B)" AutomationProperties.Name="Blur"><FontIcon Glyph="&#xE81E;" FontSize="16" /></ToggleButton>
                    <ToggleButton x:Name="DockStep" Tag="Step" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Numbered step (N)" AutomationProperties.Name="Step"><FontIcon Glyph="&#xF146;" FontSize="16" /></ToggleButton>
                    <Border Width="1" Background="{ThemeResource PxBorder}" Margin="4,6" />
                    <ToggleButton x:Name="DockCrop" Tag="Crop" Click="Tool_Click" Style="{StaticResource PxToolToggle}" ToolTipService.ToolTip="Crop (C)" AutomationProperties.Name="Crop"><FontIcon Glyph="&#xE7A8;" FontSize="16" /></ToggleButton>
                    <Button x:Name="DockColor" Style="{StaticResource PxGhostButton}" Click="CustomColor_Click" ToolTipService.ToolTip="Colour" Padding="6,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="DockColorDot" Width="22" Height="22" />
                            <TextBlock x:Name="DockColorText" FontSize="12" FontFamily="{StaticResource PxMono}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Inspector -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource PxBg1}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer>
                <StackPanel Padding="16,16,16,16" Spacing="16">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="ACTIVE TOOL" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock x:Name="ToolName" Text="Select" Style="{StaticResource PxHeadlineSm}" />
                        </StackPanel>
                        <Border Style="{StaticResource PxBadge}" HorizontalAlignment="Right"><TextBlock x:Name="ToolKey" Text="Shortcut V" Style="{StaticResource PxBadgeText}" /></Border>
                    </Grid>

                    <Border Background="{ThemeResource PxSurface}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="10" Padding="6">
                        <Grid ColumnSpacing="4" RowSpacing="4">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <ToggleButton x:Name="ToolSelect" Tag="Select" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7C9;" FontSize="14" /><TextBlock Text="Select" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolArrow" Grid.Column="1" Tag="Arrow" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE72A;" FontSize="14" /><TextBlock Text="Arrow" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolRect" Grid.Row="1" Tag="Rectangle" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE739;" FontSize="14" /><TextBlock Text="Rectangle" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolEllipse" Grid.Row="1" Grid.Column="1" Tag="Ellipse" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEA3A;" FontSize="14" /><TextBlock Text="Ellipse" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolLine" Grid.Row="2" Tag="Line" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE738;" FontSize="14" /><TextBlock Text="Line" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolText" Grid.Row="2" Grid.Column="1" Tag="Text" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8D2;" FontSize="14" /><TextBlock Text="Text" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolStep" Grid.Row="3" Tag="Step" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xF146;" FontSize="14" /><TextBlock Text="Steps" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolHighlight" Grid.Row="3" Grid.Column="1" Tag="Highlight" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7E6;" FontSize="14" /><TextBlock Text="Highlight" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolBlur" Grid.Row="4" Tag="Blur" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE81E;" FontSize="14" /><TextBlock Text="Blur" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolPixelate" Grid.Row="4" Grid.Column="1" Tag="Pixelate" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE80A;" FontSize="14" /><TextBlock Text="Pixelate" /></StackPanel></ToggleButton>
                            <ToggleButton x:Name="ToolCrop" Grid.Row="5" Tag="Crop" Click="Tool_Click" Style="{StaticResource ToolRow}"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7A8;" FontSize="14" /><TextBlock Text="Crop" /></StackPanel></ToggleButton>
                        </Grid>
                    </Border>

                    <!-- Crop panel -->
                    <StackPanel x:Name="CropPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="CROP" Style="{StaticResource PxLabelCaps}" />
                        <TextBlock x:Name="CropInfo" Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" />
                        <Button x:Name="ResetCropButton" Content="Reset crop" Style="{StaticResource PxSecondaryButton}" Click="ResetCrop_Click" />
                    </StackPanel>

                    <!-- Properties -->
                    <StackPanel x:Name="PropsPanel" Spacing="12">
                        <Grid>
                            <TextBlock Text="OBJECT PROPERTIES" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock x:Name="PropsTarget" Style="{StaticResource PxCaption}" HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel x:Name="ColorRow" Spacing="8">
                            <Grid>
                                <TextBlock Text="Colour" FontSize="13" />
                                <TextBlock x:Name="ColorHex" FontSize="12" FontFamily="{StaticResource PxMono}" Foreground="{StaticResource PxAccent}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="7" />
                        </StackPanel>
                        <StackPanel x:Name="StrokeRow" Spacing="2">
                            <Grid><TextBlock Text="Stroke weight" FontSize="13" /><TextBlock x:Name="StrokeText" Style="{StaticResource PxCaption}" HorizontalAlignment="Right" /></Grid>
                            <Slider x:Name="StrokeSlider" Minimum="1" Maximum="24" StepFrequency="1" ValueChanged="Prop_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="OpacityRow" Spacing="2">
                            <Grid><TextBlock Text="Opacity" FontSize="13" /><TextBlock x:Name="OpacityText" Style="{StaticResource PxCaption}" HorizontalAlignment="Right" /></Grid>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="Prop_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="SizeRow" Spacing="2">
                            <Grid><TextBlock x:Name="SizeLabel" Text="Font size" FontSize="13" /><TextBlock x:Name="SizeText" Style="{StaticResource PxCaption}" HorizontalAlignment="Right" /></Grid>
                            <Slider x:Name="SizeSlider" Minimum="8" Maximum="120" StepFrequency="1" ValueChanged="Prop_Changed" />
                        </StackPanel>
                        <StackPanel x:Name="TextRow" Spacing="4">
                            <TextBlock Text="Text" FontSize="13" />
                            <TextBox x:Name="TextInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" TextChanged="TextInput_Changed" />
                            <CheckBox x:Name="BoldBox" Content="Bold" Click="Bold_Click" />
                        </StackPanel>
                        <TextBlock x:Name="RedactNote" Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="Blur and pixelate rewrite the pixels in the saved file, so the original content cannot be recovered from it." />
                    </StackPanel>

                    <!-- Markup stack -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Name="StackTitle" Text="MARKUP STACK (0)" Style="{StaticResource PxLabelCaps}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0">
                                <Button Style="{StaticResource PxGhostButton}" Padding="6" MinWidth="28" MinHeight="28" Click="LayerUp_Click" ToolTipService.ToolTip="Bring forward" AutomationProperties.Name="Bring forward"><FontIcon Glyph="&#xE70E;" FontSize="12" /></Button>
                                <Button Style="{StaticResource PxGhostButton}" Padding="6" MinWidth="28" MinHeight="28" Click="LayerDown_Click" ToolTipService.ToolTip="Send backward" AutomationProperties.Name="Send backward"><FontIcon Glyph="&#xE70D;" FontSize="12" /></Button>
                                <Button Style="{StaticResource PxGhostButton}" Padding="6" MinWidth="28" MinHeight="28" Click="Delete_Click" ToolTipService.ToolTip="Delete (Del)" AutomationProperties.Name="Delete"><FontIcon Glyph="&#xE74D;" FontSize="12" /></Button>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="LayerList" SelectionMode="Single" SelectionChanged="LayerList_SelectionChanged" MaxHeight="260">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="MinHeight" Value="34" />
                                    <Setter Property="Padding" Value="10,0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock x:Name="LayerEmpty" Text="Annotations you add appear here." Style="{StaticResource PxCaption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Quick output -->
            <Border Grid.Row="1" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Spacing="8">
                    <TextBlock Text="QUICK OUTPUT" Style="{StaticResource PxLabelCaps}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource PxSurface}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="OutputFormat" FontSize="13" VerticalAlignment="Center" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource PxSecondaryButton}" HorizontalAlignment="Stretch" Content="Copy to clipboard" Click="Copy_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
