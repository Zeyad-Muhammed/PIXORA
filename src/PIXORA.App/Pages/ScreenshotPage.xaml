<Page
    x:Class="PIXORA.App.Pages.ScreenshotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource PxBg0}">

    <ScrollViewer>
        <StackPanel Padding="28,22,28,28" Spacing="20" MaxWidth="1200" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="Screenshot" Style="{StaticResource PxHeadlineLg}" />
                <TextBlock Text="Choose what to capture. PIXORA hides itself while capturing, then saves and opens the result as configured below." Style="{StaticResource PxBodySecondary}" />
            </StackPanel>

            <!-- Capture targets -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ToggleButton x:Name="ModeRegion" Tag="Region" Click="Mode_Click" Style="{StaticResource PxModeTile}" IsChecked="True" AutomationProperties.Name="Region">
                    <StackPanel Spacing="8">
                        <Grid><Border Style="{StaticResource PxIconTile}" Width="42" Height="42" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8B3;" FontSize="18" /></Border>
                            <Border Style="{StaticResource PxBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="KeyRegion" Style="{StaticResource PxBadgeText}" /></Border></Grid>
                        <TextBlock Text="Capture Region" Style="{StaticResource PxHeadlineSm}" />
                        <TextBlock Text="Drag a rectangle with handles and live pixel size, or click a window to snap to it." Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModeWindow" Grid.Column="1" Tag="Window" Click="Mode_Click" Style="{StaticResource PxModeTile}" AutomationProperties.Name="Window">
                    <StackPanel Spacing="8">
                        <Grid><Border Style="{StaticResource PxIconTile}" Width="42" Height="42" HorizontalAlignment="Left"><FontIcon Glyph="&#xE737;" FontSize="18" /></Border>
                            <Border Style="{StaticResource PxBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="KeyWindow" Style="{StaticResource PxBadgeText}" /></Border></Grid>
                        <TextBlock Text="Active Window" Style="{StaticResource PxHeadlineSm}" />
                        <TextBlock Text="Hover to highlight a window, click to capture it, even if partly covered." Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModeFull" Grid.Column="2" Tag="FullScreen" Click="Mode_Click" Style="{StaticResource PxModeTile}" AutomationProperties.Name="Full screen">
                    <StackPanel Spacing="8">
                        <Grid><Border Style="{StaticResource PxIconTile}" Width="42" Height="42" HorizontalAlignment="Left"><FontIcon Glyph="&#xE740;" FontSize="18" /></Border>
                            <Border Style="{StaticResource PxBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="KeyFull" Style="{StaticResource PxBadgeText}" /></Border></Grid>
                        <TextBlock Text="Full Screen" Style="{StaticResource PxHeadlineSm}" />
                        <TextBlock x:Name="FullDesc" Text="Every connected display in one image." Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="ModeMonitor" Grid.Column="3" Tag="Monitor" Click="Mode_Click" Style="{StaticResource PxModeTile}" AutomationProperties.Name="Single display">
                    <StackPanel Spacing="8">
                        <Border Style="{StaticResource PxIconTile}" Width="42" Height="42" HorizontalAlignment="Left"><FontIcon Glyph="&#xE7F4;" FontSize="18" /></Border>
                        <TextBlock Text="Single Display" Style="{StaticResource PxHeadlineSm}" />
                        <TextBlock Text="One monitor at its native resolution." Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="380" /></Grid.ColumnDefinitions>

                <!-- Options -->
                <Border Style="{StaticResource PxPanel}" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Capture options" Style="{StaticResource PxHeadlineSm}" />
                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ComboBox x:Name="MonitorBox" Header="Display" HorizontalAlignment="Stretch" DisplayMemberPath="Label" IsEnabled="False" />
                            <ComboBox x:Name="DelayBox" Grid.Column="1" Header="Delay" HorizontalAlignment="Stretch" SelectionChanged="Option_SelectionChanged">
                                <ComboBoxItem Content="No delay" Tag="0" />
                                <ComboBoxItem Content="1 second" Tag="1" />
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                                <ComboBoxItem Content="10 seconds" Tag="10" />
                            </ComboBox>
                            <ComboBox x:Name="FormatBox" Grid.Row="1" Header="Save format" HorizontalAlignment="Stretch" SelectionChanged="Option_SelectionChanged">
                                <ComboBoxItem Content="PNG (lossless)" Tag="Png" />
                                <ComboBoxItem Content="JPEG" Tag="Jpeg" />
                                <ComboBoxItem Content="WebP" Tag="WebP" />
                            </ComboBox>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="Save folder" FontSize="14" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FolderText" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Change" Style="{StaticResource PxSecondaryButton}" Click="ChangeFolder_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="2">
                            <ToggleSwitch x:Name="AutoSaveSwitch" Header="Save automatically to the folder" Toggled="Option_Changed" />
                            <ToggleSwitch x:Name="ClipboardSwitch" Header="Copy to clipboard after capture" Toggled="Option_Changed" />
                            <ToggleSwitch x:Name="EditorSwitch" Header="Open in the editor after capture" Toggled="Option_Changed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CaptureButton" Style="{StaticResource PxPrimaryButton}" Click="Capture_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE722;" FontSize="14" /><TextBlock x:Name="CaptureLabel" Text="Capture region" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource PxSecondaryButton}" Click="Paste_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE77F;" FontSize="14" /><TextBlock Text="Edit image from clipboard" /></StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Last capture -->
                <Border Grid.Column="1" Style="{StaticResource PxPanel}" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Last capture" Style="{StaticResource PxHeadlineSm}" />
                        <Grid Height="200" CornerRadius="8" Background="{ThemeResource PxBg1}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1">
                            <Image x:Name="LastImage" Stretch="Uniform" />
                            <TextBlock x:Name="LastEmpty" Text="Nothing captured yet" Style="{StaticResource PxCaption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LastName" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LastInfo" Style="{StaticResource PxCaption}" />
                        </StackPanel>
                        <StackPanel x:Name="LastActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button Style="{StaticResource PxSecondaryButton}" Click="LastEdit_Click" Content="Edit" />
                            <Button Style="{StaticResource PxSecondaryButton}" Click="LastCopy_Click" Content="Copy" />
                            <Button Style="{StaticResource PxSecondaryButton}" Click="LastReveal_Click" Content="Show in folder" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
