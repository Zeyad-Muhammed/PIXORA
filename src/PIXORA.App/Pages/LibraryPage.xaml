<Page
    x:Class="PIXORA.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PIXORA.App.ViewModels"
    Background="{ThemeResource PxBg0}">

    <Page.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="vm:MediaCardViewModel">
            <Grid Width="232" CornerRadius="10" Background="{ThemeResource PxSurface}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1">
                <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Background="{ThemeResource PxBg1}">
                    <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="28" Foreground="{ThemeResource PxTextMuted}" Visibility="{x:Bind PlaceholderVisibility}" />
                    <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                    <Border Style="{StaticResource PxBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Background="#CC0D0D0F">
                        <TextBlock Text="{x:Bind KindBadge}" Style="{StaticResource PxBadgeText}" Foreground="#E5EEF0" />
                    </Border>
                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{StaticResource PxAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="{x:Bind FavoriteVisibility}" />
                    <Border Background="#CC0D0D0F" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Visibility="{x:Bind DurationVisibility}">
                        <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="#E5EEF0" />
                    </Border>
                    <Border Background="#E6802631" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Visibility="{x:Bind MissingVisibility}">
                        <TextBlock Text="FILE MISSING" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Padding="10,8" Spacing="2">
                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PxText}" />
                    <Grid>
                        <TextBlock Text="{x:Bind When}" Style="{StaticResource PxCaption}" />
                        <TextBlock Text="{x:Bind SizeText}" Style="{StaticResource PxCaption}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:MediaCardViewModel">
            <Grid ColumnSpacing="12" Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Width="60" Height="38" CornerRadius="4" Background="{ThemeResource PxBg1}">
                    <Image Source="{x:Bind Thumb}" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="{StaticResource PxAccent}" Visibility="{x:Bind FavoriteVisibility}" />
                    <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <Border Background="#E6802631" CornerRadius="4" Padding="5,1" Visibility="{x:Bind MissingVisibility}">
                        <TextBlock Text="MISSING" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind TypeText}" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind Dimensions}" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{x:Bind DurationText}" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{x:Bind SizeText}" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="{x:Bind DateText}" Style="{StaticResource PxCaption}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CatButton" TargetType="ToggleButton" BasedOn="{StaticResource PxToolToggle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <!-- Categories -->
        <StackPanel Background="{ThemeResource PxBg1}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,0,1,0" Padding="12,20,12,12" Spacing="4">
            <TextBlock Text="LIBRARY" Style="{StaticResource PxLabelCaps}" Margin="8,0,0,8" />
            <ToggleButton x:Name="CatAll" Tag="All" Click="Category_Click" Style="{StaticResource CatButton}">
                <Grid><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B9;" FontSize="14" /><TextBlock Text="All files" /></StackPanel><TextBlock x:Name="CountAll" HorizontalAlignment="Right" FontSize="12" /></Grid>
            </ToggleButton>
            <ToggleButton x:Name="CatShots" Tag="Screenshots" Click="Category_Click" Style="{StaticResource CatButton}">
                <Grid><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEB9F;" FontSize="14" /><TextBlock Text="Screenshots" /></StackPanel><TextBlock x:Name="CountShots" HorizontalAlignment="Right" FontSize="12" /></Grid>
            </ToggleButton>
            <ToggleButton x:Name="CatRecs" Tag="Recordings" Click="Category_Click" Style="{StaticResource CatButton}">
                <Grid><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE714;" FontSize="14" /><TextBlock Text="Recordings" /></StackPanel><TextBlock x:Name="CountRecs" HorizontalAlignment="Right" FontSize="12" /></Grid>
            </ToggleButton>
            <ToggleButton x:Name="CatFav" Tag="Favorites" Click="Category_Click" Style="{StaticResource CatButton}">
                <Grid><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE734;" FontSize="14" /><TextBlock Text="Favorites" /></StackPanel><TextBlock x:Name="CountFav" HorizontalAlignment="Right" FontSize="12" /></Grid>
            </ToggleButton>
            <Border Height="1" Background="{ThemeResource PxBorder}" Margin="4,8" />
            <ToggleButton x:Name="CatTrash" Tag="Trash" Click="Category_Click" Style="{StaticResource CatButton}">
                <Grid><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE74D;" FontSize="14" /><TextBlock Text="Trash" /></StackPanel><TextBlock x:Name="CountTrash" HorizontalAlignment="Right" FontSize="12" /></Grid>
            </ToggleButton>
            <TextBlock Style="{StaticResource PxCaption}" TextWrapping="Wrap" TextTrimming="None" Margin="8,12,4,0"
                       Text="Trash hides items from the library. Files stay on disk until you delete them permanently (they go to the Recycle Bin)." />
        </StackPanel>

        <Grid Grid.Column="1" Padding="24,18,24,0" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="Heading" Text="All files" Style="{StaticResource PxHeadlineMd}" />
                    <TextBlock x:Name="SubHeading" Style="{StaticResource PxCaption}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search by name" QueryIcon="Find" Width="240" TextChanged="Search_TextChanged" />
                    <ComboBox x:Name="SortBox" Width="170" SelectionChanged="Sort_Changed">
                        <ComboBoxItem Content="Newest first" Tag="DateNewest" IsSelected="True" />
                        <ComboBoxItem Content="Oldest first" Tag="DateOldest" />
                        <ComboBoxItem Content="Name A–Z" Tag="NameAZ" />
                        <ComboBoxItem Content="Name Z–A" Tag="NameZA" />
                        <ComboBoxItem Content="Largest first" Tag="SizeLargest" />
                        <ComboBoxItem Content="Smallest first" Tag="SizeSmallest" />
                    </ComboBox>
                    <Border Background="{ThemeResource PxBg1}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="GridToggle" Style="{StaticResource PxToolToggle}" IsChecked="True" Click="ViewMode_Click" Tag="Grid" ToolTipService.ToolTip="Grid view" AutomationProperties.Name="Grid view"><FontIcon Glyph="&#xF0E2;" FontSize="14" /></ToggleButton>
                            <ToggleButton x:Name="ListToggle" Style="{StaticResource PxToolToggle}" Click="ViewMode_Click" Tag="List" ToolTipService.ToolTip="List view" AutomationProperties.Name="List view"><FontIcon Glyph="&#xE8FD;" FontSize="14" /></ToggleButton>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource PxSecondaryButton}" Click="Refresh_Click" ToolTipService.ToolTip="Rescan folders and detect missing files">
                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Selection actions -->
            <Border x:Name="ActionBar" Grid.Row="1" Background="{ThemeResource PxElevated}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="10" Padding="10,6" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="4,0" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                        <Button x:Name="ActOpen" Style="{StaticResource PxGhostButton}" Click="Open_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8E5;" FontSize="13" /><TextBlock Text="Open" /></StackPanel></Button>
                        <Button x:Name="ActEditVideo" Style="{StaticResource PxGhostButton}" Click="EditVideo_Click" AutomationProperties.Name="Edit video"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B2;" FontSize="13" /><TextBlock Text="Edit video" /></StackPanel></Button>
                        <Button x:Name="ActRename" Style="{StaticResource PxGhostButton}" Click="Rename_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8AC;" FontSize="13" /><TextBlock Text="Rename" /></StackPanel></Button>
                        <Button x:Name="ActFav" Style="{StaticResource PxGhostButton}" Click="Favorite_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon x:Name="FavGlyph" Glyph="&#xE734;" FontSize="13" /><TextBlock x:Name="FavText" Text="Favorite" /></StackPanel></Button>
                        <Button x:Name="ActCopy" Style="{StaticResource PxGhostButton}" Click="Copy_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8C8;" FontSize="13" /><TextBlock Text="Copy" /></StackPanel></Button>
                        <Button x:Name="ActExport" Style="{StaticResource PxGhostButton}" Click="Export_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xEDE1;" FontSize="13" /><TextBlock Text="Export" /></StackPanel></Button>
                        <Button x:Name="ActReveal" Style="{StaticResource PxGhostButton}" Click="Reveal_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE838;" FontSize="13" /><TextBlock Text="Show in folder" /></StackPanel></Button>
                        <Border Width="1" Background="{ThemeResource PxBorder}" Margin="4,6" />
                        <Button x:Name="ActTrash" Style="{StaticResource PxGhostButton}" Click="Trash_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Move to Trash" /></StackPanel></Button>
                        <Button x:Name="ActRestore" Style="{StaticResource PxGhostButton}" Click="Restore_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE777;" FontSize="13" /><TextBlock Text="Restore" /></StackPanel></Button>
                        <Button x:Name="ActRemove" Style="{StaticResource PxGhostButton}" Click="RemoveEntry_Click"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE711;" FontSize="13" /><TextBlock Text="Remove from library" /></StackPanel></Button>
                        <Button x:Name="ActDelete" Style="{StaticResource PxGhostButton}" Click="Delete_Click" Foreground="{StaticResource PxError}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74D;" FontSize="13" /><TextBlock Text="Delete permanently" /></StackPanel></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="MissingBar" Grid.Row="2" Severity="Warning" IsClosable="True" Title="Missing files"
                     Message="Some entries point to files that were moved or deleted outside PIXORA. Select them and choose Remove from library, or restore the files and press Refresh." />

            <Grid Grid.Row="3">
                <GridView x:Name="GridViewItems" ItemTemplate="{StaticResource CardTemplate}" SelectionMode="Extended" Padding="0,0,0,20"
                          SelectionChanged="Items_SelectionChanged" DoubleTapped="Items_DoubleTapped" RightTapped="Items_RightTapped" KeyDown="Items_KeyDown" />
                <ListView x:Name="ListViewItems" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="Extended" Visibility="Collapsed" Padding="0,0,0,20"
                          SelectionChanged="Items_SelectionChanged" DoubleTapped="Items_DoubleTapped" RightTapped="Items_RightTapped" KeyDown="Items_KeyDown">
                    <ListView.Header>
                        <Grid ColumnSpacing="12" Padding="12,0,12,6" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" /><ColumnDefinition Width="80" /><ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="NAME" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock Grid.Column="2" Text="TYPE" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock Grid.Column="3" Text="DIMENSIONS" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock Grid.Column="4" Text="DURATION" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock Grid.Column="5" Text="SIZE" Style="{StaticResource PxLabelCaps}" />
                            <TextBlock Grid.Column="6" Text="DATE" Style="{StaticResource PxLabelCaps}" />
                        </Grid>
                    </ListView.Header>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE8B9;" FontSize="30" Foreground="{ThemeResource PxTextMuted}" />
                    <TextBlock x:Name="EmptyTitle" Text="Nothing here yet" Style="{StaticResource PxHeadlineSm}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Style="{StaticResource PxCaption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextTrimming="None" />
                </StackPanel>
                <ProgressRing x:Name="Busy" IsActive="False" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Page>
