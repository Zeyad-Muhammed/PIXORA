<Window
    x:Class="PIXORA.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PIXORA Capture Studio">

    <Grid x:Name="Root" Background="{ThemeResource PxBg0}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: logo, product name, version. System caption buttons render on the right. -->
        <Grid x:Name="TitleBar" Background="{ThemeResource PxBg0}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/pixora-mark-256.png" Width="20" Height="20" />
                <TextBlock Text="PIXORA" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource PxText}" />
                <TextBlock Text="Capture Studio" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource PxTextSecondary}" />
                <Border Style="{StaticResource PxBadge}" Padding="5,1">
                    <TextBlock x:Name="VersionText" Style="{StaticResource PxBadgeText}" FontSize="10" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{ThemeResource PxBg0}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="0,0,1,0" Padding="10,14,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Text="WORKSPACE" Style="{StaticResource PxLabelCaps}" Margin="10,0,0,8" />
                    <Button x:Name="NavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Home">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Home" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavScreenshot" Tag="Screenshot" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Screenshot">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7A8;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Screenshot" VerticalAlignment="Center" />
                            <TextBlock x:Name="ScreenshotHint" Grid.Column="2" FontSize="10" Foreground="{ThemeResource PxTextMuted}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavRecord" Tag="Record" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Screen Record">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE714;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Screen Record" VerticalAlignment="Center" />
                            <Ellipse x:Name="RecordingDot" Grid.Column="2" Width="8" Height="8" Fill="{StaticResource PxAccent}" Visibility="Collapsed" />
                            <TextBlock x:Name="RecordHint" Grid.Column="2" FontSize="10" Foreground="{ThemeResource PxTextMuted}" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavEditor" Tag="Editor" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Editor">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE70F;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Editor" VerticalAlignment="Center" />
                            <Ellipse x:Name="UnsavedDot" Grid.Column="2" Width="6" Height="6" Fill="{ThemeResource PxTextSecondary}" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavLibrary" Tag="Library" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Library">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Library" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Style="{StaticResource PxBadge}" Padding="5,0">
                                <TextBlock x:Name="LibraryCount" Style="{StaticResource PxBadgeText}" FontSize="10" Text="0" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Button x:Name="NavSettings" Tag="Settings" Click="Nav_Click" Style="{StaticResource PxNavButton}" AutomationProperties.Name="Settings">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Background="{ThemeResource PxSurface}" BorderBrush="{ThemeResource PxBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="{StaticResource PxSuccess}" />
                                <TextBlock x:Name="StorageText" FontSize="11" Foreground="{ThemeResource PxTextSecondary}" Text="Storage" />
                            </StackPanel>
                            <ProgressBar x:Name="StorageBar" Minimum="0" Maximum="100" Foreground="{StaticResource PxSuccess}" Background="{ThemeResource PxBorder}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Column="1" Background="{ThemeResource PxBg0}">
                <Frame x:Name="ContentFrame" />
                <InfoBar x:Name="Banner" IsOpen="False" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,20,20" MaxWidth="460" />
            </Grid>
        </Grid>
    </Grid>
</Window>
