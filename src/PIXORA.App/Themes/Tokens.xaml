<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PIXORA design tokens (Stitch "Fluent Dark Capture"). Accent is used sparingly for primary/active states. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PxBg0Color">#0D0D0F</Color>
            <Color x:Key="PxBg1Color">#141417</Color>
            <Color x:Key="PxSurfaceColor">#1A1A1D</Color>
            <Color x:Key="PxElevatedColor">#222226</Color>
            <Color x:Key="PxHoverColor">#2C2C32</Color>
            <Color x:Key="PxBorderColor">#303035</Color>
            <Color x:Key="PxBorderHoverColor">#48484A</Color>
            <Color x:Key="PxTextColor">#E5EEF0</Color>
            <Color x:Key="PxTextSecondaryColor">#A3A3AA</Color>
            <Color x:Key="PxTextMutedColor">#777780</Color>
            <SolidColorBrush x:Key="PxBg0" Color="#0D0D0F" />
            <SolidColorBrush x:Key="PxBg1" Color="#141417" />
            <SolidColorBrush x:Key="PxSurface" Color="#1A1A1D" />
            <SolidColorBrush x:Key="PxElevated" Color="#222226" />
            <SolidColorBrush x:Key="PxHover" Color="#2C2C32" />
            <SolidColorBrush x:Key="PxBorder" Color="#303035" />
            <SolidColorBrush x:Key="PxBorderHover" Color="#48484A" />
            <SolidColorBrush x:Key="PxText" Color="#E5EEF0" />
            <SolidColorBrush x:Key="PxTextSecondary" Color="#A3A3AA" />
            <SolidColorBrush x:Key="PxTextMuted" Color="#777780" />
            <SolidColorBrush x:Key="PxAccentWash" Color="#1FC75C64" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PxBg0Color">#F4F4F6</Color>
            <Color x:Key="PxBg1Color">#ECECEF</Color>
            <Color x:Key="PxSurfaceColor">#FFFFFF</Color>
            <Color x:Key="PxElevatedColor">#F7F7F9</Color>
            <Color x:Key="PxHoverColor">#E6E6EA</Color>
            <Color x:Key="PxBorderColor">#D8D8DE</Color>
            <Color x:Key="PxBorderHoverColor">#B9B9C2</Color>
            <Color x:Key="PxTextColor">#17171A</Color>
            <Color x:Key="PxTextSecondaryColor">#55555E</Color>
            <Color x:Key="PxTextMutedColor">#7C7C86</Color>
            <SolidColorBrush x:Key="PxBg0" Color="#F4F4F6" />
            <SolidColorBrush x:Key="PxBg1" Color="#ECECEF" />
            <SolidColorBrush x:Key="PxSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PxElevated" Color="#F7F7F9" />
            <SolidColorBrush x:Key="PxHover" Color="#E6E6EA" />
            <SolidColorBrush x:Key="PxBorder" Color="#D8D8DE" />
            <SolidColorBrush x:Key="PxBorderHover" Color="#B9B9C2" />
            <SolidColorBrush x:Key="PxText" Color="#17171A" />
            <SolidColorBrush x:Key="PxTextSecondary" Color="#55555E" />
            <SolidColorBrush x:Key="PxTextMuted" Color="#7C7C86" />
            <SolidColorBrush x:Key="PxAccentWash" Color="#1FC75C64" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="PxAccentColor">#C75C64</Color>
    <SolidColorBrush x:Key="PxAccent" Color="#C75C64" />
    <SolidColorBrush x:Key="PxAccentHover" Color="#D67078" />
    <SolidColorBrush x:Key="PxAccentPressed" Color="#B24A52" />
    <SolidColorBrush x:Key="PxSuccess" Color="#6FDB9C" />
    <SolidColorBrush x:Key="PxError" Color="#FF8A80" />
    <SolidColorBrush x:Key="PxScrim" Color="#99000000" />

    <!-- Re-point the system accent so built-in controls (toggles, sliders, focus) use the PIXORA coral. -->
    <Color x:Key="SystemAccentColor">#C75C64</Color>
    <Color x:Key="SystemAccentColorLight1">#D67078</Color>
    <Color x:Key="SystemAccentColorLight2">#E08A90</Color>
    <Color x:Key="SystemAccentColorLight3">#EAA6AB</Color>
    <Color x:Key="SystemAccentColorDark1">#B24A52</Color>
    <Color x:Key="SystemAccentColorDark2">#9F3E47</Color>
    <Color x:Key="SystemAccentColorDark3">#802631</Color>

    <x:Double x:Key="PxTitleBarHeight">40</x:Double>
    <CornerRadius x:Key="PxRadiusControl">8</CornerRadius>
    <CornerRadius x:Key="PxRadiusPanel">12</CornerRadius>
    <CornerRadius x:Key="PxRadiusPill">999</CornerRadius>
    <FontFamily x:Key="PxIcons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="PxFont">Segoe UI Variable Text,Segoe UI</FontFamily>
    <FontFamily x:Key="PxMono">Cascadia Mono,Consolas</FontFamily>
</ResourceDictionary>
